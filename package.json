{
  "name": "dsh-session-delete",
  "version": "1.0.0",
  "description": "Delete conversations from the DeepSeek Harness sidebar instead of only archiving them.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "conversation",
    "delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanloyer/dsh-session-delete.git"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
